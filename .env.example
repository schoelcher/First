# ─── EquityScope – API Keys ────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# The dashboard works without any keys; missing sources are skipped gracefully.

# ── Finnhub (free tier) ─────────────────────────────────────────────────────
# Sign up at https://finnhub.io → Dashboard → API Key
FINNHUB_API_KEY=

# ── NewsAPI (free tier) ─────────────────────────────────────────────────────
# Sign up at https://newsapi.org → Get API Key
NEWS_API_KEY=

# ── Alpha Vantage (free tier) ────────────────────────────────────────────────
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# ── Portfolio 123 ────────────────────────────────────────────────────────────
# Log in to https://www.portfolio123.com → Account → API Keys → Create Key
# P123_API_ID  = your numeric Portfolio 123 user / API ID
# P123_API_KEY = the API key string from the key management page
P123_API_ID=
P123_API_KEY=

# ── Dashboard settings (optional) ────────────────────────────────────────────
# DASHBOARD_PORT=8000
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_CACHE_TTL_HOURS=4
# DASHBOARD_HEADLESS=true
